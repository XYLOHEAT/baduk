# Cloudflare Pages headers.
# COOP+COEP enable cross-origin isolation -> SharedArrayBuffer -> multithreaded
# WASM fallback for the Neural tier. All app resources are same-origin, so CORP
# same-origin keeps every asset loadable under COEP. (GitHub Pages ignores this file;
# there WebGPU still works, WASM falls back to single-thread.)
# frame-ancestors is IGNORED in a <meta> CSP, so the anti-framing rule has to be a
# real header (the rest of the document CSP stays in the meta tag).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'

# Workers are NOT governed by the document's <meta> CSP — their CSP comes from the
# HTTP header on the worker script response. Set connect-src 'self' here so the
# vendored neural worker can fetch only same-origin assets (no phone-home / exfil).
# Only connect-src is constrained, so TF.js WASM/blob internals keep working.
/neural-worker.js
  Content-Security-Policy: connect-src 'self'
/worker.js
  Content-Security-Policy: connect-src 'self'

# tfjs wasm: cache hard. (Model caching is set by functions/models on R2 hits only,
# so a transient 404 there is never cached as immutable.)
/tfjs/*
  Cache-Control: public, max-age=31536000, immutable

# compact KataGo net (static, <25 MiB) for Medium/Hard — immutable, content-addressed by name
/assets/models/*
  Cache-Control: public, max-age=31536000, immutable
