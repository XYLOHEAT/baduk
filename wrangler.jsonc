{
  // Cloudflare Pages config. The R2 binding lets functions/models/[[path]].js
  // stream the big dan net (>25MB) from R2, same-origin.
  "name": "baduk",
  "pages_build_output_dir": ".",
  "compatibility_date": "2024-12-01",
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "baduk-models" }
  ]
}
